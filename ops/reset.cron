# CTF stateful-task auto-reset. Shared instances get trashed by players, so
# DB-backed tasks are wiped + re-provisioned on a schedule. Stateless tasks are
# NOT listed here (restart: unless-stopped + flag re-drop on restart is enough).
#
# Install:  crontab -u ctf ops/reset.cron   (adjust the path to ctfctl)
# Announce the cadence to players. Staggered so the two DBs don't reprovision together.

CTF=/opt/ctf/ctf-2026

*/30 * * * *   cd $CTF && ./ctfctl reset web-silent-channel >> /var/log/ctf/reset.log 2>&1
15,45 * * * *  cd $CTF && ./ctfctl reset web-joombreaker    >> /var/log/ctf/reset.log 2>&1
10,40 * * * *  cd $CTF && ./ctfctl reset web-neon-auth      >> /var/log/ctf/reset.log 2>&1
20,50 * * * *  cd $CTF && ./ctfctl reset web-sql-console    >> /var/log/ctf/reset.log 2>&1

# Disk safety: prune dangling images/build cache older than a day, off-peak.
30 4 * * *     docker system prune -f --filter until=24h >> /var/log/ctf/prune.log 2>&1
