# CTF stateful-task auto-reset. GENERATED by 'ctfctl gen-cron' — do not hand-edit.
# Shared instances get trashed by players, so DB-backed tasks are wiped + re-provisioned
# on a schedule. Stateless tasks (restart: unless-stopped) are not listed.
# Install:  crontab -u ctf ops/reset.cron   (adjust CTF path)

CTF=/opt/ctf/ctf-2026

0,30 * * * *  cd $CTF && ./ctfctl reset web-silent-channel   >> /var/log/ctf/reset.log 2>&1
7,37 * * * *  cd $CTF && ./ctfctl reset web-joombreaker      >> /var/log/ctf/reset.log 2>&1
15,45 * * * *  cd $CTF && ./ctfctl reset web-neon-auth        >> /var/log/ctf/reset.log 2>&1
22,52 * * * *  cd $CTF && ./ctfctl reset web-sql-console      >> /var/log/ctf/reset.log 2>&1

# Disk safety: prune dangling images/build cache older than a day, off-peak.
30 4 * * *     docker system prune -f --filter until=24h >> /var/log/ctf/prune.log 2>&1
