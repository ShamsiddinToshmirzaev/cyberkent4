# Copy to db.env (git-ignored) and set real values. Rotate anything ever committed.
MYSQL_ROOT_PASSWORD=CHANGE_ME_root
MYSQL_DATABASE=wordpress
MYSQL_USER=wpctf
MYSQL_PASSWORD=CHANGE_ME_pw
# WordPress reuses the same DB user/password; admin_password is set to WORDPRESS_DB_PASSWORD
WORDPRESS_DB_USER=wpctf
WORDPRESS_DB_PASSWORD=CHANGE_ME_pw
WORDPRESS_DB_NAME=wordpress
